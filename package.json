{
  "name": "srtf-scheduler",
  "version": "1.0.0",
  "private": true,
  "description": "Offline single-core SRTF preemptive scheduling backend (API + CLI)",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/scheduler.test.js",
