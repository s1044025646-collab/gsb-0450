    "cli": "npm run build --silent && node dist/src/cli.js",
    "demo": "npm run build --silent && node dist/src/cli.js demo"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^5.9.0"
  }
}
